{
  "name": "codex-agent-teams-local",
  "version": "0.7.0",
  "private": true,
  "description": "Quality-first, compact task delegation for Codex",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "codex-teams": "./src/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "update": "node scripts/update.js",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "doctor": "node src/cli.js doctor",
    "mcp": "node src/cli.js mcp",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include='src/*.js' tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
